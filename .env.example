# Copy to .env and change every secret. Never commit .env.
SITE_DOMAIN=localhost
FRONTEND_URL=https://localhost
ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=https://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
JWT_SIGNING_KEY=change-me-to-another-long-random-string
DJANGO_DEBUG=0

POSTGRES_DB=expenseflow
POSTGRES_USER=expenseflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://expenseflow:change-me@postgres:5432/expenseflow
MONGO_URL=mongodb://mongo:27017/expenseflow
REDIS_URL=redis://redis:6379/0

# dev: smtp://mailpit:1025   prod (Brevo): smtp+tls://USER:PASSWORD@smtp-relay.brevo.com:587
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=ExpenseFlow <no-reply@expenseflow.dev>

GRAFANA_PASSWORD=change-me
# set by CI on the server
REGISTRY=ghcr.io/your-org/expenseflow
IMAGE_TAG=latest
