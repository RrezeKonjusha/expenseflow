@startuml dfd
!include _style.iuml
left to right direction
title ExpenseFlow - Data flow diagram (level 1)

rectangle "Employee" as E
rectangle "Manager" as M
rectangle "Admin" as A
rectangle "Email inbox" as MAIL

usecase "1. Authenticate" as P1
usecase "2. Manage expenses" as P2
usecase "3. Decide expenses" as P3
usecase "4. Report and export" as P4
usecase "5. Administer" as P5
usecase "6. Audit" as P6

database "D1 users / tokens" as D1
database "D2 projects / members" as D2
database "D3 expenses" as D3
database "D4 audit_logs (Mongo)" as D4
database "D5 report_snapshots (Mongo)" as D5

E --> P1 : credentials
P1 --> D1 : verify, store tokens
P1 --> MAIL : activation / reset link
E --> P2 : expense data, CSV file
P2 --> D2 : check membership
P2 --> D3 : drafts, submissions
M --> P3 : approve / reject
P3 --> D3 : status change
P3 --> D2 : spent (trigger)
A --> P5 : users, departments, projects
P5 --> D1
P5 --> D2
E --> P4 : criteria
D3 --> P4 : aggregated rows
P4 --> D5 : saved snapshot
P4 --> E : CSV / XLSX / JSON
P1 --> P6 : events
P2 --> P6 : events
P3 --> P6 : events
P5 --> P6 : events
P6 --> D4
D4 --> A : audit log view
@enduml
