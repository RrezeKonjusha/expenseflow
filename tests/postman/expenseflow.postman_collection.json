    {
      "name": "Expenses",
      "item": [
        {
          "name": "List (paged)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/expenses/?page_size=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"paged\", () => pm.expect(pm.response.json().results.length).to.be.at.most(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search full-text",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/expenses/?q=hotel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "SQL injection attempt is harmless",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/expenses/?q=' OR 1=1 --"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create meal above policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/expenses/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"MEAL\",\n  \"project\": \"{{alphaId}}\",\n  \"amount\": \"60.00\",\n  \"attendees\": 1,\n  \"expense_date\": \"{{recent}}\",\n  \"description\": \"Postman lunch\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"policy\", () => pm.expect(pm.response.json().type).to.eql(\"policy_violation\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const d = new Date(Date.now() - 2*864e5).toISOString().slice(0,10);",
                  "pm.collectionVariables.set(\"recent\", d);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create meal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/expenses/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"MEAL\",\n  \"project\": \"{{alphaId}}\",\n  \"amount\": \"48.00\",\n  \"attendees\": 2,\n  \"expense_date\": \"{{recent}}\",\n  \"description\": \"Postman lunch\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"expenseId\", j.id);",
                  "pm.test(\"HATEOAS submit link\", () => pm.expect(j._links).to.have.property(\"submit\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "XSS in description rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/expenses/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"MEAL\",\n  \"project\": \"{{alphaId}}\",\n  \"amount\": \"10\",\n  \"attendees\": 1,\n  \"expense_date\": \"{{recent}}\",\n  \"description\": \"<script>alert(1)</script>\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}/submit/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"SUBMITTED\", () => pm.expect(pm.response.json().status).to.eql(\"SUBMITTED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Employee cannot approve own (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}/approve/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager approves",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}/approve/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"APPROVED\", () => pm.expect(pm.response.json().status).to.eql(\"APPROVED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve again is 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}/approve/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reimburse (stored procedure)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/expenses/reimburse/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"until\": \"{{recent}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"count\", () => pm.expect(pm.response.json().reimbursed).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        }
      ]
    },
